# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- 虚拟环境 ----
.venv/
venv/
env/
ENV/

# ---- 数据与缓存（体积大，不入库）----
era5_cache/
*.npy
*.npz
/datasets/

# 注：这里刻意不忽略 data/ 目录本身，否则 figures/data/（论文表格锚点数据
# 与台风最佳路径 CSV）会被连带排除。只忽略工作区根目录下的 data/。
/data/
# figures/data/ 为交付数据，必须入库（覆盖上面的规则）
!figures/data/
!figures/data/**

